{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/fonts/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/static/fonts/$1"
    },
    {
      "src": "/static/videos/(.*)",
      "headers": {
        "Accept-Ranges": "bytes",
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/static/videos/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/public/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
